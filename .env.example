# StageVote configuration.
#
# Development: run `scripts/bootstrap.sh`. It copies this file to `.env` and replaces every
# `<...>` placeholder with a generated local secret. It never overwrites values you set.
# Production: see docs/operations.md. Never commit `.env`.

# ---- Application -----------------------------------------------------------
# development | test | production. Production refuses Mailpit, plain-text SMTP,
# non-HTTPS base URLs and example.com sender addresses.
APP_ENV=development
# Public origin participants open. Cookies, CSRF/origin checks and email links use it.
APP_BASE_URL=http://localhost:3000
# Host port the local proxy listens on (development compose only).
STAGEVOTE_HTTP_PORT=3000
# Interface the local proxy binds to. Use 0.0.0.0 to test from phones on your LAN.
STAGEVOTE_BIND=127.0.0.1
# Additional browser origins allowed to call the API (comma separated). Normally empty:
# the proxy keeps the app and API on one origin.
EXTRA_ALLOWED_ORIGINS=
# HMAC key for CSRF tokens and other server-side signatures. 32+ random characters.
APP_SECRET_KEY=<generated-server-only-secret>
# Default IANA timezone for a new programme; each programme stores its own.
PROGRAMME_TIMEZONE=Asia/Kolkata
PRODUCT_NAME=StageVote

# ---- Database ----------------------------------------------------------------
# Runtime role (restricted: no UPDATE/DELETE on votes or the audit log).
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
# Owner role used only by migrations and the bootstrap command.
DATABASE_MIGRATION_URL=postgresql+asyncpg://<owner-user>:<owner-password>@<host>:5432/<database>
DB_APP_ROLE=stagevote_app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Number of API processes (each keeps its own pool and live listener).
API_WORKERS=2
# Statement timeout and how long a vote may wait for a live transition to finish.
DB_STATEMENT_TIMEOUT_MS=15000
VOTE_LOCK_TIMEOUT_MS=5000
# Passwords used by the local PostgreSQL container on first start only.
POSTGRES_SUPERUSER_PASSWORD=<generated>
DB_OWNER_PASSWORD=<generated>
DB_APP_PASSWORD=<generated>
# Host port for the local database (bound to 127.0.0.1; used by the test suite).
DB_HOST_PORT=55432

# ---- First admin -------------------------------------------------------------
# Used once to create the first admin when no admin with this email exists. Reruns never
# reset an existing admin's password. Remove the password from the environment after
# first start in production, or use `stagevote create-admin` instead.
ADMIN_BOOTSTRAP_EMAIL=<admin-email>
ADMIN_BOOTSTRAP_PASSWORD=<strong-initial-password>

# ---- Credentials and sessions -----------------------------------------------
# Fernet key (32 url-safe base64 bytes) that encrypts the password inside a queued
# invitation email while delivery may still need it. Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
INVITATION_ENCRYPTION_KEY=<generated-server-only-key>
# Absolute lifetime of a participant browser session. Long enough for a multi-hour
# programme; logout, an organiser's session reset or a re-sent invitation end it earlier.
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=12
# How long the encrypted copy of an emailed password is kept so a failed delivery can be
# retried with the same password. The password itself does not expire; sending a new
# invitation replaces it.
INVITATION_RETRY_HOURS=72

# ---- Rate limits (failed attempts only; a venue shares one public IP) --------
LOGIN_FAILURES_PER_ACCOUNT=8
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_FAILURES_PER_IP=1000
LOGIN_IP_WINDOW_SECONDS=600

# ---- Email -------------------------------------------------------------------
# mailpit (local test inbox) | smtp | gmail_workspace | disabled
EMAIL_PROVIDER=mailpit
MAIL_FROM="StageVote <noreply@example.com>"
MAIL_REPLY_TO=
# SMTP (also used by the mailpit provider). SMTP_TLS_MODE: none | starttls | tls.
# `none` is for the local Mailpit profile only and is refused in production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=none
SMTP_TIMEOUT_SECONDS=30
# Google Workspace Gmail API (domain-wide delegation). See docs/email-setup.md.
# Path to a read-only mounted service-account JSON file inside the containers. Never put
# the JSON itself in an environment variable.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Workspace mailbox the service account impersonates (the participant-facing sender).
GOOGLE_WORKSPACE_SENDER=
# Delivery pacing and retries.
EMAIL_MAX_PER_MINUTE=120
EMAIL_CONCURRENCY=4
EMAIL_MAX_ATTEMPTS=6
# Link shown in the admin email page for the local inbox (development only).
MAILPIT_UI_URL=http://localhost:8025
MAILPIT_UI_PORT=8025

# ---- Uploads -----------------------------------------------------------------
MEDIA_ROOT=/data/media
MAX_UPLOAD_BYTES=5242880

# ---- Runtime tuning ------------------------------------------------------------
# Concurrent Argon2 password hashes per API process (bounds memory during login bursts).
PASSWORD_HASH_CONCURRENCY=8
LOG_LEVEL=INFO

# ---- Production only (compose.prod.yaml) ----------------------------------------
# Public hostname served with automatic HTTPS, and the contact for certificate notices.
SITE_DOMAIN=
ACME_EMAIL=
# Image tag to run; "local" builds from this checkout.
STAGEVOTE_VERSION=local
