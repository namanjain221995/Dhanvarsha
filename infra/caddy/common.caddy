# Shared routing and headers, imported by Caddyfile and Caddyfile.prod.
encode zstd gzip

request_body {
	max_size 12MB
}

header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	X-Frame-Options DENY
	Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Cross-Origin-Opener-Policy same-origin
	-Server
}

handle /api/* {
	reverse_proxy {$API_UPSTREAM:api:8000} {
		header_up X-Request-ID {http.request.uuid}
	}
}

@socket path /ws /ws/admin
handle @socket {
	reverse_proxy {$API_UPSTREAM:api:8000} {
		stream_close_delay 5m
	}
}

# Uploaded files only: random names written by the API, never a page. The sandbox CSP keeps a
# file from running as a document even if a browser were to render it as one. file_server
# answers Range requests, which video seeking needs; .uploads/ (unfinished uploads) never
# matches these names.
handle_path /media/* {
	root * /srv/media
	header {
		Content-Security-Policy "default-src 'none'; sandbox"
		X-Content-Type-Options nosniff
	}
	@image path_regexp ^/[a-f0-9]{32}\.webp$
	handle @image {
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Type image/webp
		file_server
	}
	@mp4 path_regexp ^/[a-f0-9]{32}\.mp4$
	handle @mp4 {
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Type video/mp4
		file_server
	}
	@webm path_regexp ^/[a-f0-9]{32}\.webm$
	handle @webm {
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Type video/webm
		file_server
	}
	respond 404
}

handle {
	reverse_proxy {$WEB_UPSTREAM:web:3000}
}
